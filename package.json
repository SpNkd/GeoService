{
  "name": "geoservice",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test && npm run build && npm run test:e2e",
    "bench:audit": "node --expose-gc node_modules/vitest/vitest.mjs run --config benchmarks/vitest.config.ts",
    "bench:render": "node benchmarks/render.mjs",
    "dev:mock": "AI_PROVIDER=mock vite --host 127.0.0.1",
    "bench:ai": "node --expose-gc node_modules/vitest/vitest.mjs run --config benchmarks/vitest.config.ts benchmarks/ai.audit.ts",
    "bench:ai-dependent": "node --expose-gc node_modules/vitest/vitest.mjs run --config benchmarks/vitest.config.ts benchmarks/ai-dependent.audit.ts",
    "bench:ai-reliability": "node --expose-gc node_modules/vitest/vitest.mjs run --config benchmarks/vitest.config.ts benchmarks/ai-reliability.audit.ts",
    "bench:georeferencing": "node --expose-gc node_modules/vitest/vitest.mjs run --config benchmarks/vitest.config.ts benchmarks/georeferencing.audit.ts",
    "bench:ai-spatial": "node --expose-gc node_modules/vitest/vitest.mjs run --config benchmarks/vitest.config.ts benchmarks/ai-spatial.audit.ts",
    "bench:dxf": "node --expose-gc node_modules/vitest/vitest.mjs run --config benchmarks/vitest.config.ts benchmarks/dxf.audit.ts",
    "preview:static": "node scripts/preview-static.mjs",
    "deploy:pages": "node scripts/publish-pages.mjs"
  },
  "description": "Deterministic geodetic drawing editor prototype",
  "dependencies": {
    "dxf-parser": "1.1.2",
    "pdfjs-dist": "5.4.624",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "6.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SpNkd/GeoService.git"
  },
  "homepage": "https://spnkd.github.io/GeoService/"
}
