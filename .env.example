# Server-only development configuration. Copy to .env.local (ignored by Git).
# AI is disabled when AI_PROVIDER is unset. Mock is always an explicit choice.
AI_PROVIDER=mock
# Optional real provider: change AI_PROVIDER to openai and set both values below.
# Use a Responses API model supporting Structured Outputs; configure the model here.
AI_MODEL=
OPENAI_API_KEY=
# Never use VITE_ variables for credentials. No browser API key is supported.
